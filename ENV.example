# Server runtime
NODE_ENV=
PORT=

# Database
DATABASE_URL=

# Session and OAuth
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Built-in admin login (used when OAUTH_SERVER_URL / VITE_OAUTH_PORTAL_URL are not set)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Storage: use "local" for the portable handover mode, otherwise configure the Forge/S3-compatible values.
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Development-only local CMS login. Never enable in production.
LOCAL_AUTH_BYPASS=
LOCAL_OWNER_OPEN_ID=
LOCAL_OWNER_NAME=
