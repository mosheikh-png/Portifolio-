# Required in production (minimum 16 characters)
JWT_SECRET=

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=assets/public

# Database (Back4App provides this automatically)
# DATABASE_URL=

# Admin credentials (set for built-in login)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS (comma-separated origins for production)
# ALLOWED_ORIGINS=https://your-domain.com

# Optional: AI generation (Gemini)
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-3.6-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: OAuth (Manus/Forge - not needed for local)
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Port
PORT=3000
